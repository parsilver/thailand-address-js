// Static assets only: no Worker script. Personal Lead deploys with
// `pnpm --filter @thailand-address/demo deploy` (wrangler deploy).
// Never point this at thailand-address.farzai.com, which is reserved.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thailand-address-demo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "thailand-address-demo.farzai.com", "custom_domain": true }]
}
